# Copy to .env.local for `motif-server`; on Vercel set these in Project Settings.
# The Neon integration on the Vercel Marketplace sets DATABASE_URL (pooled) and
# DATABASE_URL_UNPOOLED (direct, used for migrations) itself.
DATABASE_URL=postgres://motif:motif@localhost:5432/motif
# At least 32 random bytes, e.g. `openssl rand -base64 48`.
MOTIF_JWT_SECRET=
# Optional, off when empty. Username and password sign-in needs neither.
# Bundle ids allowed as the audience of Sign in with Apple tokens, e.g. app.motif.Motif.
MOTIF_APPLE_AUDIENCES=
# Google OAuth client ids (iOS client and the web client Android uses).
MOTIF_GOOGLE_CLIENT_IDS=
# Local development only: also accept {"provider":"dev","id_token":"<any subject>"} at /v1/auth/token.
MOTIF_DEV_AUTH=1
